# ── Database (PostgreSQL) ────────────────────────────────────────────────
# Configure EITHER a full connection string...
#   Plain postgresql:// and postgres:// URLs are accepted too — the driver is
#   normalized to asyncpg automatically. Use this for hosted providers.
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/jansunwayi"

# ...OR leave DATABASE_URL empty and set these components instead. The backend
# percent-encodes the credentials, so the password may contain @ / : + = and
# other URL-special characters. This is what docker-compose uses.
# POSTGRES_HOST="localhost"
# POSTGRES_PORT=5432
# POSTGRES_USER="postgres"
# POSTGRES_PASSWORD="postgres"
# POSTGRES_DB="jansunwayi"

# Set to true to log every SQL statement (noisy; useful when debugging).
DB_ECHO=false

# ── Auth ─────────────────────────────────────────────────────────────────
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_DAYS=7

# Bootstrap admin account, created on first server start if no admin exists.
ADMIN_EMAIL="admin@jansunwayi.gov.in"
ADMIN_PASSWORD="change-me-immediately"

# ── Gemini AI (can also be set later from the Admin Dashboard) ────────────
GEMINI_API_KEY=""

# ── Twilio ────────────────────────────────────────────────────────────────
# Used only to deliver Aadhaar e-KYC OTPs by SMS. Without these the OTP flow still runs for real — random, hashed,
# expiring, attempt-limited — but the code is shown on screen and the UI
# labels it as a sandbox e-KYC.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# ── Auto-escalation job ───────────────────────────────────────────────────
# Background sweep that advances grievances left unattended past 48h.
ESCALATION_ENABLED=true
ESCALATION_SWEEP_MINUTES=15

# ── Demo toggle ───────────────────────────────────────────────────────────
# When true, the Aadhaar e-KYC step accepts ANY 12-digit number — the UIDAI
# Verhoeff checksum and the leading-digit rule are skipped, and the OTP rate
# limit is loosened. Currently the demo default (real UIDAI integration is
# pending). Set to false to restore genuine structural validation.
AADHAAR_RELAXED_VALIDATION=true

# ── CORS ─────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins for the web frontend. Add your
# deployed web domain(s) here in production.
CORS_ORIGINS="http://localhost:5173,http://localhost:3000"
