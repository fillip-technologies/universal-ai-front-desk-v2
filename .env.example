# Used by `docker compose up` (docker-compose.yml / docker-compose.dev.yml) —
# copy to .env in this same directory and edit before running.
#
# For non-Docker local dev, the backend instead reads backend/.env — see
# backend/.env.example. This file only matters for the Docker workflow.

# ── PostgreSQL ───────────────────────────────────────────────────────────
# Passed to the app as separate components (not as a URL string), so the
# password may safely contain @ / : + = and other URL-special characters.
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="change-me-to-a-strong-password"
POSTGRES_DB="jansunwayi"

# Dev stack only: host port for the Postgres container. Change this if you
# already run PostgreSQL locally on 5432.
POSTGRES_HOST_PORT=5432

# ── Auth ─────────────────────────────────────────────────────────────────
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_DAYS=7

ADMIN_EMAIL="admin@jansunwayi.gov.in"
ADMIN_PASSWORD="change-me-immediately"

# ── Gemini AI (can also be set later from the Admin Dashboard) ────────────
GEMINI_API_KEY=""

# ── Twilio ────────────────────────────────────────────────────────────────
# Used only to deliver Aadhaar e-KYC OTPs by SMS. Without these the OTP flow still runs for real — random, hashed,
# expiring, attempt-limited — but the code is shown on screen and the UI
# labels it as a sandbox e-KYC.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# ── Auto-escalation job ───────────────────────────────────────────────────
# Sweeps open grievances and advances any left unattended past 48h.
ESCALATION_ENABLED=true
ESCALATION_SWEEP_MINUTES=15

# ── Demo toggle ───────────────────────────────────────────────────────────
# true = Aadhaar e-KYC accepts ANY 12-digit number (UIDAI checksum skipped).
# Set to false before any real deployment.
AADHAAR_RELAXED_VALIDATION=true

# Comma-separated list of allowed origins for the frontend.
CORS_ORIGINS="http://localhost:8000"
